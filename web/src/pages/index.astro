---
import Base from "../layouts/Base.astro";
import PublicationCard from "../components/PublicationCard.astro";
import { loadPublications } from "../lib/publications";
import { loadNews } from "../lib/news";

const pubs = loadPublications();
const featured = pubs.filter((p) => p.highlight).slice(0, 4);
const news = loadNews().slice(0, 8);

const press = [
  {
    image: "/press/nhb_2025.webp",
    venue: "Nature Human Behaviour",
    year: 2025,
    blurb: "Our work on modelling human beliefs with LLMs",
    href: "https://www.nature.com/articles/s41562-025-02228-z",
  },
  {
    image: "/press/nature_news_2020_jisun.webp",
    venue: "Nature News",
    year: 2020,
    blurb: "Jisun featured for computational social science research",
    href: "https://media.nature.com/original/magazine-assets/d41586-020-01747-1/d41586-020-01747-1.pdf",
  },
  {
    image: "/press/nature_news_2016_haewoon.webp",
    venue: "Nature News",
    year: 2016,
    blurb: "Haewoon's work covered for toxic behavior in online games",
    href: "https://www.nature.com/articles/531568a",
  },
];
---

<Base>
  {/* Board 01. The lab's own poster, at the scale a poster has in life: you
      read the title from across the aisle and the rest when you stop. */}
  <section class="board board-bleed relative -mt-10 py-14 sm:py-20">
    <div class="mx-auto max-w-5xl px-6">
      <div class="grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_17rem] lg:gap-10">
      <div class="stock relative px-7 py-10 sm:px-12 sm:py-14">
        <h1 class="poster-title">
          Studying social phenomena with <strong>large-scale data</strong> and <strong>AI</strong>
        </h1>
        <p class="author-strip mt-7">
          Haewoon Kwak &nbsp;·&nbsp; Jisun An
          <span class="block mt-1 font-normal normal-case tracking-normal" style="color: var(--color-ink-faint);">
            Luddy School of Informatics, Computing, and Engineering &nbsp;·&nbsp; Indiana University Bloomington
          </span>
        </p>
        <div class="mt-8 flex flex-wrap gap-3 text-sm">
          <a href="/publications" class="act-primary">Browse all papers</a>
          <a href="/openings" class="act-secondary">Join the lab</a>
        </div>
      </div>

        {/* Press the lab actually earned: three covers, pinned. There is no
            fourth, so the frame does not pretend otherwise. The caption is a
            printed strip under the clipping, not a scrim over it. */}
        <figure
          id="press-carousel"
          class="relative mx-auto w-full max-w-[17rem] lg:mx-0"
          data-count={press.length}
        >
          <div class="overflow-hidden" style="box-shadow: inset 0 0 0 1px rgba(0,0,0,0.25);">
            <div
                id="press-track"
                class="flex transition-transform duration-500 ease-out"
                style={`width: ${press.length * 100}%`}
            >
                {press.map((p, i) => (
                  <div class="shrink-0" style={`width: ${100 / press.length}%`}>
                    {p.href ? (
                        <a href={p.href} target="_blank" rel="noopener" class="block">
                          <img
                            src={p.image}
                            alt={`${p.venue}, ${p.year}`}
                            width="800" height="1050"
                            class="aspect-[992/1318] w-full object-contain"
                            style="background-color: var(--color-paper-2);"
                            loading={i === 0 ? "eager" : "lazy"}
                            fetchpriority={i === 0 ? "high" : "auto"}
                            decoding="async"
                          />
                        </a>
                    ) : (
                        <img
                          src={p.image}
                          alt={`${p.venue}, ${p.year}`}
                          width="800" height="1050"
                          class="aspect-[992/1318] w-full object-contain"
                          style="background-color: var(--color-paper-2);"
                          loading="lazy" decoding="async"
                        />
                    )}
                  </div>
                ))}
            </div>
          </div>

          <figcaption class="press-strip">
            <div class="flex items-baseline justify-between gap-4">
                <p>
                  {press.map((p, i) => (
                    <span data-press-caption={i} class={i === 0 ? "" : "hidden"}>
                        <span class="press-venue">{p.venue}</span>, {p.year}
                        <span class="press-blurb">{p.blurb}</span>
                    </span>
                  ))}
                </p>
                <span class="press-pos" aria-live="polite">
                  <span id="press-index">1</span> / {press.length}
                </span>
                <div class="flex shrink-0 gap-px">
                  <button id="press-prev" type="button" aria-label="Previous clipping" class="press-step">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
                  </button>
                  <button id="press-next" type="button" aria-label="Next clipping" class="press-step">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                  </button>
                </div>
            </div>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="grid gap-8 pt-12 pb-12 lg:grid-cols-[minmax(0,1fr)_19rem] lg:gap-10">
    <div class="stock self-start space-y-10 px-7 py-9 sm:px-9">
      <p class="read text-base" style="color: var(--color-ink-soft);">
        Led by
        <a href="/team" class="font-medium underline decoration-1 underline-offset-2 hover:decoration-2" style="color: var(--color-ink); text-decoration-color: var(--color-rule);">Haewoon Kwak</a>
        and
        <a href="/team" class="font-medium underline decoration-1 underline-offset-2 hover:decoration-2" style="color: var(--color-ink); text-decoration-color: var(--color-rule);">Jisun An</a>,
        we focus on human behavior on online platforms: its
        <em>measurement</em>, <em>understanding</em>, <em>design</em>, and the
        <em>assessment of its implications</em>. Every day we use our devices to read the
        news, watch videos, search for places to eat, chat with friends, and post on social
        media. Those electronic footprints make it possible to study both individual and
        collective behavior, including what people like and dislike, how they feel about
        different topics, and how they engage with one another. Understanding human behavior
        on these platforms has become essential.
      </p>


      <div class="space-y-5 read">
        <p class="text-base" style="color: var(--color-ink-soft);">
          We develop new computational methods and tools for understanding, predicting, and
          shaping human behavior online. A central challenge is the sheer
          <em>diversity and complexity</em> of online data. We work across many kinds of
          large-scale data, examining existing tools, surfacing their limits, and developing
          new measurements, machine-learning models, and linguistic methods that let us
          understand online behavior and address real-world problems.
        </p>

        <p class="text-base" style="color: var(--color-ink-soft);">
          But our goal is not only to solve problems. We also want to improve the online
          spaces themselves. We are interested in identifying obstacles to a
          <em>trustworthy public space online</em>, developing methodologies that make those
          obstacles transparent, building frameworks for real-time large-scale monitoring,
          and ultimately helping the online public square become more credible.
        </p>

        <p class="text-base" style="color: var(--color-ink-soft);">
          We are based at the
          <a href="https://luddy.indiana.edu/" target="_blank" rel="noopener" class="text-[var(--color-accent)] hover:underline">Luddy School of Informatics, Computing, and Engineering</a>
          at Indiana University Bloomington, and a member of the
          <a href="https://cnets.indiana.edu/" target="_blank" rel="noopener" class="text-[var(--color-accent)] hover:underline">Center for Complex Networks and Systems Research (CNetS)</a>.
        </p>
      </div>
    </div>

    {news.length > 0 && (
      <aside aria-labelledby="news-heading" class="stock self-start px-6 py-6">
        <h2 id="news-heading" class="text-[11px] font-semibold uppercase tracking-[0.14em]" style="color: var(--color-ink-faint);">
          News
        </h2>
        <ul class="mt-3 space-y-3 border-t pt-3" style="border-color: var(--color-rule);">
          {news.map((n) => (
            <li class="text-sm leading-relaxed">
              <div class="text-[10px] font-semibold uppercase tracking-[0.14em]" style="color: var(--color-ink-faint);">
                {n.date}
              </div>
              <div class="mt-0.5 news-item" set:html={n.headline} style="color: var(--color-ink-soft);" />
            </li>
          ))}
        </ul>
      </aside>
    )}
  </section>

  <style>
    .poster-title {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: clamp(38px, 5.6vw, 68px);
      line-height: 1.06;
      letter-spacing: -0.035em;
      color: var(--color-ink);
      text-wrap: balance;
    }
    .poster-title strong { font-weight: 700; }

    .author-strip {
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--color-ink-soft);
    }

    .act-primary,
    .act-secondary {
      font-weight: 600;
      letter-spacing: 0.04em;
      padding: 0.7rem 1.15rem;
      transition: background-color 0.15s ease, color 0.15s ease;
    }
    .act-primary {
      background-color: var(--color-accent);
      color: var(--color-paper);
    }
    .act-primary:hover { background-color: #7d0000; }
    .act-secondary {
      background-color: transparent;
      color: var(--color-ink);
      box-shadow: inset 0 0 0 1.5px var(--color-ink);
    }
    .act-secondary:hover {
      background-color: var(--color-ink);
      color: var(--color-paper);
    }

    /* Anchors inside the news sidebar are rendered via set:html, so they
       don't get Astro's data-astro-cid scope attribute. Wrap the `a`
       selector in :global() so the rule still matches. */
    .press-strip {
      background-color: var(--color-ink);
      color: var(--color-paper);
      padding: 0.6rem 0.85rem;
      font-size: 12px;
      line-height: 1.45;
    }
    .press-venue { font-weight: 700; }
    .press-blurb {
      display: block;
      color: color-mix(in srgb, var(--color-paper) 66%, transparent);
    }
    .press-pos {
      flex-shrink: 0;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.1em;
      font-variant-numeric: tabular-nums;
      color: color-mix(in srgb, var(--color-paper) 72%, transparent);
    }
    .press-step {
      display: grid;
      place-items: center;
      width: 1.9rem;
      height: 1.9rem;
      background-color: color-mix(in srgb, var(--color-paper) 14%, transparent);
      color: var(--color-paper);
      transition: background-color 0.15s ease;
    }
    .press-step:hover { background-color: var(--color-accent); }

    .news-item :global(a) {
      color: var(--color-accent);
      text-decoration: underline;
      text-decoration-color: color-mix(in srgb, var(--color-accent) 35%, transparent);
      text-underline-offset: 2px;
    }
    .news-item :global(a:hover) {
      text-decoration-color: var(--color-accent);
    }
  </style>

  <script>
    (() => {
      const root = document.getElementById("press-carousel") as HTMLElement | null;
      const track = document.getElementById("press-track") as HTMLElement | null;
      const captions = Array.from(document.querySelectorAll<HTMLElement>("[data-press-caption]"));
      const posEl = document.getElementById("press-index");
      // Someone who asked the OS for less motion did not ask for a slideshow.
      const still = window.matchMedia("(prefers-reduced-motion: reduce)");
      const prev = document.getElementById("press-prev") as HTMLButtonElement | null;
      const next = document.getElementById("press-next") as HTMLButtonElement | null;
      if (!root || !track) return;
      const count = parseInt(root.dataset.count || "1", 10);
      let idx = 0;
      let timer: number | undefined;

      function render() {
        track!.style.transform = `translateX(-${(idx * 100) / count}%)`;
        captions.forEach((c, i) => c.classList.toggle("hidden", i !== idx));
        if (posEl) posEl.textContent = String(idx + 1);
      }
      function go(i: number) {
        idx = (i + count) % count;
        render();
        resetTimer();
      }
      function stopTimer() {
        if (timer) window.clearInterval(timer);
        timer = undefined;
      }
      function resetTimer() {
        stopTimer();
        if (still.matches) return;
        timer = window.setInterval(() => go(idx + 1), 6000);
      }

      prev?.addEventListener("click", () => go(idx - 1));
      next?.addEventListener("click", () => go(idx + 1));
      // Pause for a pointer and for a keyboard alike; the old version only
      // listened for a mouse, so a keyboard reader got yanked mid-sentence.
      root.addEventListener("mouseenter", stopTimer);
      root.addEventListener("mouseleave", resetTimer);
      root.addEventListener("focusin", stopTimer);
      root.addEventListener("focusout", resetTimer);
      still.addEventListener("change", resetTimer);

      render();
      resetTimer();
    })();
  </script>

  <section class="pt-4 pb-12">
    <div class="mb-7 flex items-baseline justify-between border-b pb-3" style="border-color: var(--color-rule);">
      <h2 class="text-2xl font-semibold tracking-tight">Featured work</h2>
      <a href="/publications" class="text-sm font-semibold" style="color: var(--color-accent);">All papers &rarr;</a>
    </div>
    <div>
      {featured.map((p, i) => <PublicationCard pub={p} board={i + 1} />)}
    </div>
  </section>
</Base>
