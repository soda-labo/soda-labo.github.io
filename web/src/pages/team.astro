---
import Base from "../layouts/Base.astro";
import Masthead from "../components/Masthead.astro";
import Email from "../components/Email.astro";
import { loadMembers } from "../lib/members";

const members = loadMembers();
---

<Base title="Team · SoDA Lab" description="Faculty, PhD students, visitors, and alumni of the Social Data and AI Lab at Indiana University Bloomington.">
  <Masthead title="Team" lede="The people behind SoDA Lab." />

  <section class="mb-14">
    <h2 class="mb-5 border-b pb-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-[var(--color-ink-faint)]" style="border-color: var(--color-rule);">Faculty</h2>
    {/* Two cards side by side only once each card is wide enough for a photo
        and a readable text column; below 1024px a card spans the row. Below
        640px the photo stacks above the text, or the text column collapses to
        a word per line. */}
    <div class="grid gap-8 lg:grid-cols-2">
      {members.faculty.map((f) => (
        <article class="stock flex min-w-0 flex-col gap-4 px-5 py-5 sm:flex-row sm:gap-5">
          {f.photo && (
            <img
              src={`/teampic/${f.photo}`}
              alt={f.name}
              width="128" height="128"
              class="h-32 w-32 shrink-0 object-cover" style="box-shadow: inset 0 0 0 1px var(--color-rule);"
              decoding="async"
            />
          )}
          <div class="min-w-0">
            <h3 class="text-lg font-semibold text-[var(--color-ink)]">{f.name}</h3>
            <p class="text-base text-[var(--color-ink-soft)]">{f.role}</p>
            <ul class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-base">
              {f.website && <li><a href={f.website} class="text-[var(--color-accent)] hover:underline" target="_blank" rel="noopener">Website</a></li>}
              {f.scholar && <li><a href={f.scholar} class="text-[var(--color-accent)] hover:underline" target="_blank" rel="noopener">Scholar</a></li>}
              {f.cv && <li><a href={f.cv} class="text-[var(--color-accent)] hover:underline" target="_blank" rel="noopener">CV</a></li>}
              {f.email && (
                <li>
                  <Email
                    user={f.email.split("@")[0]}
                    host={f.email.split("@")[1]}
                    class="text-[var(--color-accent)] hover:underline"
                  />
                </li>
              )}
            </ul>
            {f.education && f.education.length > 0 && (
              <div class="mt-3 text-base text-[var(--color-ink-soft)]">
                <div class="text-xs font-semibold uppercase tracking-wide text-[var(--color-ink-faint)]">Background</div>
                <ul class="mt-1.5 list-disc space-y-1 pl-4 marker:text-[var(--color-ink-faint)]">
                  {f.education.map((e) => <li set:html={e} />)}
                </ul>
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="mb-14">
    <h2 class="mb-5 border-b pb-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-[var(--color-ink-faint)]" style="border-color: var(--color-rule);">PhD Students</h2>
    <ul class="grid gap-x-6 gap-y-3 sm:grid-cols-2 lg:grid-cols-3">
      {members.phd_students.map((s) => (
        <li class="flex items-center gap-3">
          <div class="grid h-10 w-10 shrink-0 place-items-center bg-[var(--color-ink)] text-[11px] font-bold tracking-wider text-[var(--color-paper)]">
            {/* Strip parenthetical nicknames like "Shirui (Olivia) Zhou" so
                the initials don't include "(". Then take the first letter of
                each remaining word, up to two. */}
            {s.name.replace(/\([^)]*\)/g, " ").split(/\s+/).filter(Boolean).map((w) => w[0]).slice(0, 2).join("")}
          </div>
          <div class="min-w-0">
            <div class="text-base font-medium text-[var(--color-ink)]">{s.name}</div>
            {s.website && <a href={s.website} class="text-xs text-[var(--color-accent)] hover:underline" target="_blank" rel="noopener">website</a>}
          </div>
        </li>
      ))}
    </ul>
  </section>

  {members.visitors.length > 0 && (
    <section class="mb-14">
      <h2 class="mb-5 border-b pb-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-[var(--color-ink-faint)]" style="border-color: var(--color-rule);">Visitors</h2>
      <ul class="space-y-2 text-base text-[var(--color-ink-soft)]">
        {members.visitors.map((v) => (
          <li>
            {v.name}
            {v.affiliation && <span class="text-[var(--color-ink-faint)]"> · {v.affiliation}</span>}
          </li>
        ))}
      </ul>
    </section>
  )}

  <section>
    <h2 class="mb-5 border-b pb-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-[var(--color-ink-faint)]" style="border-color: var(--color-rule);">Alumni</h2>

    <div class="space-y-6 text-base">
      <div>
        <h3 class="mb-2 font-medium text-[var(--color-ink)]">Postdoctoral researchers</h3>
        <ul class="space-y-1 text-[var(--color-ink-soft)]">
          {members.alumni.postdocs.map((a) => (
            <li>
              {a.website ? (
                <a href={a.website} class="hover:text-[var(--color-accent)]" target="_blank" rel="noopener">{a.name}</a>
              ) : a.name}
              {a.now && <span class="text-[var(--color-ink-faint)]"> · {a.now}</span>}
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="mb-2 font-medium text-[var(--color-ink)]">Visitors</h3>
        <ul class="space-y-1 text-[var(--color-ink-soft)]">
          {members.alumni.visitors.map((a) => (
            <li>
              {a.name}
              {a.affiliation && <span class="text-[var(--color-ink-faint)]"> · {a.affiliation}</span>}
              {a.year && <span class="text-[var(--color-ink-faint)]"> · {a.year}</span>}
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="mb-2 font-medium text-[var(--color-ink)]">Graduate students (SMU)</h3>
        <ul class="space-y-1 text-[var(--color-ink-soft)]">
          {members.alumni.graduate_smu.map((a) => (
            <li>{a.name}{a.year && <span class="text-[var(--color-ink-faint)]"> · {a.year}</span>}</li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="mb-2 font-medium text-[var(--color-ink)]">Undergraduate students (SMU)</h3>
        <ul class="space-y-1 text-[var(--color-ink-soft)]">
          {members.alumni.undergraduate_smu.map((a) => (
            <li>{a.name}{a.year && <span class="text-[var(--color-ink-faint)]"> · {a.year}</span>}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</Base>
