---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "SoDA Lab · Social Data and AI",
  description = "The Social Data and AI Lab at Indiana University Bloomington, led by Haewoon Kwak and Jisun An.",
} = Astro.props;

// Link previews (Slack, KakaoTalk, X, LinkedIn) read these. Without them a
// shared link shows a bare URL, which matters for a site whose main job is
// recruiting. The card image is the home page's first screen, so a preview
// looks like the place it opens.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const shareImage = new URL("/og-image.jpg", Astro.site).href;

// Google Analytics 4, running cookieless. The measurement ID is not a secret
// (it ships in the page source), so it lives here rather than in .env, which
// keeps the GitHub Actions build from needing a new secret. Leave it as the
// placeholder to disable. Only loads in a production build, so `npm run dev`
// never touches the stats.
const GA_MEASUREMENT_ID = "G-DF3QY4S455";
const analyticsEnabled =
  import.meta.env.PROD && GA_MEASUREMENT_ID.startsWith("G-");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#46525c" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SoDA Lab" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SoDA Lab: studying social phenomena with large-scale data and AI" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    {analyticsEnabled && (
      <>
        <script
          is:inline
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}
        />
        <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }

          // Consent Mode, denied by default and never asked. GA4 then sends
          // cookieless pings: no _ga identifier is written, so there is no
          // consent banner to show and nothing to remember between visits.
          // The trade is real and deliberate: without a client id, returning
          // visitors are counted fresh each time, so "users" reads closer to
          // "visits" and anything longitudinal is modelled rather than
          // measured. Pageviews, referrers, and which pages get read are
          // unaffected, and those are what this site is asking about.
          // Do not "restore" the default consent state to fix a user count.
          gtag('consent', 'default', {
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
            analytics_storage: 'denied',
          });

          gtag('js', new Date());
          gtag('config', GA_MEASUREMENT_ID, {
            anonymize_ip: true,
            client_storage: 'none',
          });
        </script>
      </>
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Load font CSS without render-blocking: preload as style, then swap rel
        on load. System fonts paint first, then web fonts swap in (display=swap
        in the URL guarantees no FOIT). The <noscript> fallback keeps things
        working for crawlers and ancient browsers. */}
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,500;1,7..72,400&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,500;1,7..72,400&display=swap"
      />
    </noscript>
  </head>
  <body class="min-h-screen antialiased">
    <!--
      THESIS: The corpus is a poster hall, not a ledger. Refuses the lab-site
      publication list where a Nature paper and a workshop preprint are set at
      identical size.
      OWN-WORLD: Slate board fabric (#46525c) carrying white poster stock
      (#f6f6f3); ink #14181b; IU crimson (#990000) board tags; Archivo signage
      caps over Literata reading text; the eight topics demoted from decoration
      to track colors that say which section of the hall a board stands in.
      STORY: A visitor walks the aisle, sees which work the lab stops at, and
      finds the board that is theirs.
      FIRST VIEWPORT: Board 01 full-bleed on fabric, carrying two pinned
      things: the lab's statement at poster scale with both PI names as the
      author strip, and the press clipping that covered the work. Two actions,
      one per audience. The lab's own board wears no number; crimson board tags
      address the work, starting at 01 on the featured boards.
      FORM: Poster Session, candidate 6 of 7, seed f6bd662d.
      FINISH: unreviewed and undocumented is unfinished; this build ends with
      the finish review, the verdict, DESIGN.md, and every shipping raster
      carrying its provenance.
    -->
    <Header />
    <main class="mx-auto max-w-5xl px-6 py-10">
      <slot />
    </main>
    <Footer />
  </body>
</html>
