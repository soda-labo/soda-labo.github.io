---
// The hall's directory strip. One board fabric bar across the top, the lab's
// badge pinned to it, destinations set as signage. The previous header gave
// every nav item its own colour, which made the palette decorative; here the
// only colour is the crimson tag, and it means "you are at this board".
const navItems = [
  { href: "/",             label: "Home" },
  { href: "/publications", label: "Publications" },
  { href: "/team",         label: "Team" },
  { href: "/research",     label: "Research" },
  { href: "/openings",     label: "Openings" },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) =>
  path === href || (href !== "/" && path.startsWith(href));
---

<header class="board">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
    <a href="/" class="flex items-center gap-3 whitespace-nowrap">
      {/* The mark is a Venn of three sets. On fabric it reads as a badge
          printed on stock and pinned up, which is how anything paper gets
          onto a board in this world. */}
      <span class="stock grid h-11 w-11 shrink-0 place-items-center">
        <img src="/sodalab-mark.svg" alt="" class="h-8 w-8" />
      </span>
      <span class="flex flex-col leading-none">
        <span class="text-xl font-semibold tracking-tight" style="color: var(--color-on-board);">SoDA Lab</span>
        <span
          class="mt-1 hidden text-[11px] font-medium tracking-[0.14em] uppercase sm:inline"
          style="color: var(--color-on-board-faint);"
        >Social Data &amp; AI</span>
      </span>
    </a>

    <button
      id="nav-toggle"
      type="button"
      aria-label="Toggle navigation"
      aria-expanded="false"
      aria-controls="primary-nav"
      class="grid h-10 w-10 place-items-center md:hidden"
      style="color: var(--color-on-board);"
    >
      <svg id="nav-icon-open" class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
      <svg id="nav-icon-close" class="hidden h-6 w-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>

    <nav class="hidden md:block" aria-label="Primary">
      <ul class="flex items-stretch gap-0.5 text-[11px] font-semibold tracking-[0.14em] uppercase">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? "page" : undefined}
              class:list={["nav-dest px-3 py-2.5 block transition", isCurrent(item.href) && "is-here"]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <nav id="primary-nav" class="hidden md:hidden" aria-label="Primary">
    <ul
      class="mx-auto max-w-5xl px-6 text-[13px] font-semibold tracking-[0.14em] uppercase"
      style="border-top: 1px solid color-mix(in srgb, var(--color-on-board) 14%, transparent); padding-top: 0.75rem; padding-bottom: 0.75rem;"
    >
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? "page" : undefined}
            class:list={["nav-dest mt-2 block px-3 py-3 transition", isCurrent(item.href) && "is-here"]}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .nav-dest {
    color: var(--color-on-board-soft);
  }
  .nav-dest:hover {
    color: var(--color-on-board);
    background-color: color-mix(in srgb, var(--color-on-board) 7%, transparent);
  }
  /* The crimson tag is the hall's "you are here". It is the only colour the
     directory strip is allowed. */
  .nav-dest.is-here,
  .nav-dest.is-here:hover {
    background-color: var(--color-accent);
    color: var(--color-paper);
  }
</style>

<script>
  (() => {
    const btn = document.getElementById("nav-toggle") as HTMLButtonElement | null;
    const panel = document.getElementById("primary-nav") as HTMLElement | null;
    const iOpen = document.getElementById("nav-icon-open") as HTMLElement | null;
    const iClose = document.getElementById("nav-icon-close") as HTMLElement | null;
    if (!btn || !panel) return;

    function setOpen(open: boolean) {
      panel!.classList.toggle("hidden", !open);
      btn!.setAttribute("aria-expanded", String(open));
      iOpen?.classList.toggle("hidden", open);
      iClose?.classList.toggle("hidden", !open);
    }
    btn.addEventListener("click", () => {
      setOpen(btn!.getAttribute("aria-expanded") !== "true");
    });
    const mq = window.matchMedia("(min-width: 768px)");
    mq.addEventListener("change", (e) => { if (e.matches) setOpen(false); });
  })();
</script>
