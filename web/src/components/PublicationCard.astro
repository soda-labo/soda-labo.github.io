---
import type { Publication } from "../lib/publications";
import { topicColor, topicName } from "../lib/tag-colors";

interface Props {
  pub: Publication;
  labMembers?: string[];
  /** Board address in the aisle. Omit to hide the tag. */
  board?: number;
}

const { pub, labMembers = ["haewoon kwak", "jisun an"], board } = Astro.props;

// A poster hall is not a list: some boards draw a crowd and you can see which
// from down the aisle. Citation count is the honest stand-in for that, so it
// sets the board's physical size instead of sitting in the metadata line.
const tier =
  pub.citations >= 500 ? "landmark" : pub.citations >= 100 ? "major" : "standard";

function boldifyAuthors(authors: string): string {
  if (!authors) return "";
  return authors
    .split(/,/)
    .map((a) => {
      const trimmed = a.trim();
      const isLab = labMembers.some((m) => trimmed.toLowerCase().includes(m));
      return isLab ? `<strong>${trimmed}</strong>` : `<span>${trimmed}</span>`;
    })
    .join(", ");
}

const authorsHtml = boldifyAuthors(pub.authors);
const primaryTopic = pub.tags[0];

const searchText = [
  pub.title, pub.authors, pub.venue,
  pub.year?.toString() ?? "", pub.tags.join(" "),
].join(" ").toLowerCase();
---

<article
  class:list={["pub-card pub-board stock", `is-${tier}`]}
  data-tags={pub.tags.join(",")}
  data-methods={pub.methods.join(",")}
  data-platforms={pub.platforms.join(",")}
  data-year={pub.year ?? ""}
  data-citations={pub.citations}
  data-highlight={pub.highlight ? "1" : "0"}
  data-title-key={pub.title.toLowerCase()}
  data-search={searchText}
  data-uncurated={pub.uncurated ? "1" : "0"}
>
  {board !== undefined && <span class="pub-tag" aria-hidden="true">{String(board).padStart(2, "0")}</span>}

  <div class="pub-body">
    {pub.image && (
      <img
        src={`/pubpic/${pub.image}`}
        alt=""
        class="pub-figure"
        loading="lazy"
      />
    )}

    <div class="min-w-0 flex-1">
      <h2 class="pub-title">
        {pub.link?.url ? (
          <a href={pub.link.url} target="_blank" rel="noopener">{pub.title}</a>
        ) : pub.title}
      </h2>

      {pub.authors && <p class="pub-authors" set:html={authorsHtml} />}

      <p class="pub-meta">
        {pub.venue && <span class="pub-venue">{pub.venue}</span>}
        {pub.venue && pub.year && <span aria-hidden="true"> · </span>}
        {pub.year && <span>{pub.year}</span>}
        {pub.citations > 0 && (
          <>
            <span aria-hidden="true"> · </span>
            <span>{pub.citations.toLocaleString()} citation{pub.citations === 1 ? "" : "s"}</span>
          </>
        )}
      </p>

      {pub.description && <p class="pub-abstract read">{pub.description}</p>}

      {primaryTopic && (
        <p class="pub-track">
          {/* The eight topics stop being decoration here: the swatch says
              which section of the hall this board stands in, and clicking it
              walks you to that section. */}
          {pub.tags.map((tag) => (
            <a href={`/publications?topic=${tag}`} data-tag-pill={tag} class="track-tag">
              <span class="track-swatch" style={`background-color: ${topicColor(tag).bg}`} aria-hidden="true"></span>
              {topicName(tag)}
            </a>
          ))}
        </p>
      )}
    </div>
  </div>
</article>

<style>
  .pub-board {
    position: relative;
    padding: 1.5rem 1.5rem 1.4rem;
    margin-bottom: 1.25rem;
  }
  .pub-body { display: flex; gap: 1.25rem; align-items: flex-start; }

  .pub-tag {
    position: absolute;
    top: 0; left: 0;
    transform: translate(-0.4rem, -0.6rem);
    background-color: var(--color-accent);
    color: var(--color-paper);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 0.2rem 0.45rem;
  }

  .pub-figure {
    flex-shrink: 0;
    width: 5.5rem;
    height: 5.5rem;
    object-fit: cover;
    background-color: var(--color-paper-2);
    box-shadow: inset 0 0 0 1px var(--color-rule);
  }

  .pub-title {
    font-family: var(--font-display);
    font-size: 1.1875rem;
    font-weight: 600;
    line-height: 1.32;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    text-wrap: balance;
  }
  .pub-title a:hover { color: var(--color-accent); }

  .pub-authors {
    margin-top: 0.35rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-ink-soft);
  }
  .pub-authors :global(strong) { font-weight: 700; color: var(--color-ink); }

  .pub-meta {
    margin-top: 0.15rem;
    font-size: 0.8125rem;
    color: var(--color-ink-faint);
  }
  .pub-venue { font-style: italic; }

  .pub-abstract {
    margin-top: 0.6rem;
    font-size: 1rem;
    color: var(--color-ink-soft);
  }

  .pub-track {
    margin-top: 0.8rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }
  .track-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }
  .track-tag:hover { color: var(--color-ink); }
  .track-swatch { width: 0.6rem; height: 0.6rem; display: inline-block; }

  /* Boards that draw a crowd are physically bigger. */
  .is-major { padding: 1.9rem 1.9rem 1.75rem; }
  .is-major .pub-figure { width: 7.5rem; height: 7.5rem; }
  .is-major .pub-title { font-size: 1.5rem; }

  .is-landmark { padding: 2.4rem 2.4rem 2.2rem; }
  .is-landmark .pub-figure { width: 10rem; height: 10rem; }
  .is-landmark .pub-title { font-size: 2rem; line-height: 1.3; }
  .is-landmark .pub-authors { font-size: 0.875rem; }
  .is-landmark .pub-abstract { font-size: 1.125rem; }

  @media (max-width: 640px) {
    .pub-board { padding: 1.1rem 1.1rem 1rem; }
    .pub-title { font-size: 1.0625rem; }
    /* A standard board's 72px figure crop is unreadable and steals the title
       its measure, so only boards that earned the room keep one. */
    .pub-figure { display: none; }

    .is-major { padding: 1.5rem 1.4rem 1.4rem; }
    .is-major .pub-title { font-size: 1.375rem; }

    .is-landmark { padding: 2rem 1.6rem 1.8rem; }
    .is-landmark .pub-title { font-size: 1.875rem; }
    .is-landmark .pub-abstract { font-size: 1.0625rem; }
    .is-landmark .pub-body { flex-direction: column; }
    .is-landmark .pub-figure {
      display: block;
      width: 100%;
      height: 11rem;
      margin-bottom: 1rem;
    }
  }
</style>
